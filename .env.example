PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# On EC2 set HOST=0.0.0.0; restrict port 3000 using the EC2 Security Group.
AWS_REGION=
AWS_AVAILABILITY_ZONE=
EC2_INSTANCE_ID=
BACKEND_PRIVATE_IP=
VPC_ID=
SUBNET_ID=
ALB_DNS_NAME=
# Optional: only enable on EC2. No credentials are retrieved.
ENABLE_IMDS=false
